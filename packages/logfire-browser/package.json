{
  "name": "@pydantic/logfire-browser",
  "description": "JavaScript Browser SDK for Logfire - https://pydantic.dev/logfire",
  "author": {
    "name": "The Pydantic Team",
    "email": "engineering@pydantic.dev",
    "url": "https://pydantic.dev"
  },
  "repository": {
    "url": "https://github.com/pydantic/logfire-js",
    "directory": "packages/logfire-browser"
  },
  "sideEffects": false,
  "homepage": "https://pydantic.dev/logfire",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "logfire",
    "observability",
    "opentelemetry",
    "tracing",
    "profiling",
    "stats",
    "monitoring"
  ],
  "version": "0.32.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react-router": {
      "import": {
        "types": "./dist/react-router.d.ts",
        "default": "./dist/react-router.js"
      },
      "require": {
        "types": "./dist/react-router.d.cts",
        "default": "./dist/react-router.cjs"
      }
    },
    "./tanstack-router": {
      "import": {
        "types": "./dist/tanstack-router.d.ts",
        "default": "./dist/tanstack-router.js"
      },
      "require": {
        "types": "./dist/tanstack-router.d.cts",
        "default": "./dist/tanstack-router.cjs"
      }
    },
    "./vue-router": {
      "import": {
        "types": "./dist/vue-router.d.ts",
        "default": "./dist/vue-router.js"
      },
      "require": {
        "types": "./dist/vue-router.d.cts",
        "default": "./dist/vue-router.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "lint": "vp lint",
    "preview": "vp preview",
    "typecheck": "tsc && tsc --project test-fixtures/frustration/tsconfig.json",
    "prepack": "cp ../../LICENSE .",
    "postpublish": "rm LICENSE",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-web": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/otlp-transformer": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "logfire": "workspace:*",
    "web-vitals": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/sdk-trace-web": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@pydantic/logfire-session-replay": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@pydantic/logfire-session-replay": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/context-zone": "catalog:",
    "@opentelemetry/instrumentation-fetch": "catalog:",
    "@opentelemetry/otlp-exporter-base": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@pydantic/logfire-session-replay": "workspace:*",
    "@tanstack/react-router": "^1.170.44",
    "@types/react": "^19.3.0",
    "fast-check": "^4.10.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.4.0",
    "react-router-7": "npm:react-router@^7.18.4",
    "user-agent-data-types": "^0.4.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-router-4": "npm:vue-router@^4.6.4",
    "zone.js": "^0.15.1"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
