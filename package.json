{
  "name": "@pydantic/logfire-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "build": "vp run --filter \"./packages/*\" build",
    "dev": "vp run --filter \"./packages/*\" --parallel dev",
    "test": "vp run --filter \"./packages/*\" test",
    "test:browser": "vp run @pydantic/logfire-session-replay#test:browser",
    "test:frustration-mutations": "stryker run stryker.frustration.config.mjs",
    "test:frustration-soak": "pnpm --filter @pydantic/logfire-session-replay exec playwright test --config browser-tests/frustration-soak.config.ts",
    "typecheck": "vp run --filter \"./packages/*\" typecheck && vp run --filter \"./examples/*-router\" typecheck",
    "lint": "vp lint",
    "format": "vp fmt . --write",
    "format-check": "vp fmt --check",
    "check": "pnpm run build && vp check && pnpm run typecheck && pnpm run test && pnpm run test:release-tooling && pnpm run test:docs-preview && pnpm run test:docs",
    "test:docs": "node --test scripts/browser-docs*.test.mjs",
    "release": "pnpm run build && pnpm changeset publish",
    "changeset-add": "pnpm changeset add",
    "test:release-tooling": "node scripts/create-npm-token.test.mjs",
    "test:docs-preview": "node --test scripts/docs-preview.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@stryker-mutator/core": "^10.0.0",
    "@voidzero-dev/vite-plus-core": "1.0.0",
    "chrome-devtools-mcp": "1.10.1",
    "typescript": "catalog:",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": "24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.14.1 <25",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.5.2"
}
